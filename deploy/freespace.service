# Example unit: copy to /etc/systemd/system/freespace.service, adjust paths, put a TLS proxy (Caddy, nginx) in front.
[Unit]
Description=freespace
After=network.target

[Service]
User=freespace
WorkingDirectory=/opt/freespace
Environment=FREESPACE_DATA_DIR=/var/lib/freespace
Environment=FREESPACE_PUBLIC_URL=https://spaces.example.com
Environment=HOST=127.0.0.1
Environment=PORT=8080
ExecStart=/usr/bin/node bin/freespace.js serve
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/freespace

[Install]
WantedBy=multi-user.target
